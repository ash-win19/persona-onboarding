DATABASE_URL=postgresql://user:password@localhost:5432/persona
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
APP_ORIGINS=http://localhost:3000
PORT=3001
OPENAI_REALTIME_MODEL=gpt-realtime-mini
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://usepersona.vercel.app/api/gmail/callback
# 32 random bytes encoded as base64. Keep this key stable while encrypted tokens exist.
GMAIL_TOKEN_KEY=
# Conversation memory (Mastra) is on whenever DATABASE_URL is set. Set to off to disable it.
# PERSONA_MEMORY=off
# Tokens of unsummarised conversation before notes are written (default 8000).
# PERSONA_MEMORY_OBSERVE_TOKENS=8000
